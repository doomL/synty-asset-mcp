# Copy to .env (never commit .env).
# Generate a token with:  docker compose run --rm synty-mcp token
# Put the "sha256:..." form here; give the plain token to your agents.
SYNTY_MCP_TOKENS=sha256:replace_me
# Public URL as seen by agents (behind your TLS reverse proxy). Used for file download links
# and as an allowed Host header.
SYNTY_MCP_PUBLIC_BASE_URL=https://synty.example.com
# Extra Host headers to accept (comma separated), e.g. the docker network name.
# SYNTY_MCP_ALLOWED_HOSTS=synty-mcp:8765
SYNTY_MCP_WORKERS=2
# Optional Synty Store sync (see docs/STORE_LOGIN.md). Build with WITH_PLAYWRIGHT=1.
SYNTY_MCP_STORE_ENABLED=false
# SYNTY_MCP_STORE_DOWNLOADS_URL=https://...  (copy from your browser's My Downloads page)
WITH_PLAYWRIGHT=0
# Optional SyntyDex local export (one asset name per line).
SYNTY_MCP_SYNTYDEX_ENABLED=false
# SYNTY_MCP_SYNTYDEX_EXPORT_FILE=/data/state/syntydex_export.txt
